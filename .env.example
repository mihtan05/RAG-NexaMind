# ==========================================
# NexaMind AI - Environment Variables Template
# ==========================================

# 1. Google Gemini API Key (Bắt buộc - Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Tùy chọn model Gemini (Mặc định: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 3. Cấu hình Local Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# 4. Khóa bí mật JWT Bearer Token
JWT_SECRET_KEY=nexamind-enterprise-super-secret-key-change-me-2026
JWT_ALGORITHM=HS256

# 5. Cấu hình Cơ sở dữ liệu PostgreSQL Enterprise (Tùy chọn)
# Nếu để trống hoặc máy chủ PostgreSQL chưa bật, hệ thống tự động dùng SQLite (data/nexamind.db)
# DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/nexamind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=nexamind

# 6. Cổng dịch vụ API Backend (Mặc định: 8000)
PORT=8000

# 7. Google OAuth 2.0 Web Client ID (Tùy chọn - Dùng cho nút đăng nhập Google)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
