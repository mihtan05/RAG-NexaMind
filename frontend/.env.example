# NexaMind AI / LexMind - Frontend Environment Variables

# Địa chỉ API của Backend FastAPI (Mặc định local là http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth 2.0 Client ID (Lấy từ Google Cloud Console -> APIs & Services -> Credentials)
# Nếu để trống, hệ thống sẽ tự động kích hoạt chế độ Demo Login mượt mà để thử nghiệm ngay.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
